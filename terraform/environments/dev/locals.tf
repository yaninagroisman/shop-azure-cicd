locals {
  location_short = {
    swedencentral = "swc"
    northeurope   = "neu"
    westeurope    = "weu"
    israelcentral = "ilc"
  }[var.location]

  # <type>-<project>-<environment>-<region> (Cloud Adoption Framework style)
  name_suffix = "${var.project}-${var.environment}-${local.location_short}"

  names = {
    resource_group = "rg-${local.name_suffix}"
    aks_node_rg    = "rg-${local.name_suffix}-aks-nodes"
    vnet           = "vnet-${local.name_suffix}"
    aks_subnet     = "snet-aks-nodes"
    aks_subnet_nsg = "nsg-${local.name_suffix}-aks-nodes"
    aks            = "aks-${local.name_suffix}"

    # Globally unique names (DNS): a random suffix kept in state.
    acr       = "acr${var.project}${var.environment}${local.location_short}${random_string.suffix.result}"
    key_vault = "kv-${local.name_suffix}-${random_string.suffix.result}"

    workload_identity_prefix = "id-${local.name_suffix}"

    log_analytics     = "log-${local.name_suffix}"
    monitor_workspace = "amw-${local.name_suffix}"
    action_group      = "ag-${local.name_suffix}-email"

    gateway_ip = "pip-${local.name_suffix}-gateway"
    # <label>.<region>.cloudapp.azure.com must be unique in the region.
    gateway_dns_label = "${var.project}-${var.environment}-${random_string.suffix.result}"
  }

  # Pipeline identities live in the bootstrap (AD-31a); this stack only grants
  # them roles on its own resources.
  bootstrap_resource_group = "rg-${var.project}-bootstrap-${local.location_short}"
  pipeline_identities      = toset(["tf-plan", "tf-apply", "ci"])

  # Pod identities (Workload Identity, AD-36). Namespace and service account
  # names are a contract with the Kubernetes manifests (a later stage).
  workload_identities = {
    api      = { namespace = "shop", service_account = "api" }
    consumer = { namespace = "shop", service_account = "consumer" }
    mongodb  = { namespace = "shop", service_account = "mongodb" }
    kyverno  = { namespace = "kyverno", service_account = "kyverno-admission-controller" }
  }

  # MongoDB passwords generated by Terraform (AD-36); Kafka users and
  # passwords are generated by Strimzi inside the cluster.
  mongodb_root_secret = "mongodb-root-password"
  mongodb_app_secret  = "mongodb-app-password"

  tags = {
    project     = var.project
    environment = var.environment
    owner       = var.owner
    managed-by  = "terraform"
    repo        = var.repository_url
    lifecycle   = "ephemeral" # removed by `terraform destroy` (AD-31)
  }
}
